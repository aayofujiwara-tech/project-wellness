{
  "pdf_extraction_patterns": {
    "利用者氏名": [
      "氏\\s*名[：:]?\\s*(.+)",
      "利用者氏名[：:]?\\s*(.+)",
      "利用者名[：:]?\\s*(.+)",
      "お名前[：:]?\\s*(.+)"
    ],
    "ふりがな": [
      "ふりがな[：:]?\\s*(.+)",
      "フリガナ[：:]?\\s*(.+)",
      "かな[：:]?\\s*(.+)"
    ],
    "住所": [
      "住\\s*所[：:]?\\s*(.+)",
      "現住所[：:]?\\s*(.+)"
    ],
    "性別": [
      "性\\s*別[：:]?\\s*(男|女|男性|女性)",
      "(男性|女性)"
    ],
    "生年月日": [
      "生年月日[：:]?\\s*(.+)",
      "生\\s*年\\s*月\\s*日[：:]?\\s*(.+)"
    ],
    "年齢": [
      "年\\s*齢[：:]?\\s*(\\d+)",
      "(\\d+)\\s*歳"
    ],
    "電話番号": [
      "電話番号[：:]?\\s*([\\d\\-]+)",
      "TEL[：:]?\\s*([\\d\\-]+)",
      "電\\s*話[：:]?\\s*([\\d\\-]+)"
    ],
    "要介護度": [
      "要介護度[：:]?\\s*(要介護[１-５1-5]|要支援[１-２1-2])",
      "介護度[：:]?\\s*(要介護[１-５1-5]|要支援[１-２1-2])",
      "(要介護[１-５1-5])",
      "(要支援[１-２1-2])"
    ]
  },
  "fixed_cell_mapping": {
    "form1": {
      "利用者氏名": { "cell": "E6" },
      "ふりがな":   { "cell": "B6", "format": "format_furigana" },
      "性別":       { "cell": "E7", "format": "format_gender" },
      "年齢":       { "cell": "G7", "format": "format_age" },
      "電話番号":   { "cell": "H7" },
      "住所":       { "cell": "B8" },
      "要介護度":   { "cell": "C9", "format": "format_care_level_inline" }
    },
    "form2": {
      "利用者氏名": { "cell": "E23" },
      "ふりがな":   { "cell": "B23", "format": "format_furigana" },
      "性別":       { "cell": "E24", "format": "format_gender" },
      "年齢":       { "cell": "G24", "format": "format_age" },
      "電話番号":   { "cell": "H24" },
      "住所":       { "cell": "B25" },
      "要介護度":   { "cell": "C26", "format": "format_care_level_inline" }
    }
  },
  "care_level_mapping": {
    "要支援1": ["要支援1", "要支援１", "支援1", "支援１"],
    "要支援2": ["要支援2", "要支援２", "支援2", "支援２"],
    "要介護1": ["要介護1", "要介護１", "介護1", "介護１"],
    "要介護2": ["要介護2", "要介護２", "介護2", "介護２"],
    "要介護3": ["要介護3", "要介護３", "介護3", "介護３"],
    "要介護4": ["要介護4", "要介護４", "介護4", "介護４"],
    "要介護5": ["要介護5", "要介護５", "介護5", "介護５"]
  },
  "target_sheet": "Sheet3",
  "facility_abbreviations": {
    "パシ": "パシフィック",
    "ルネ": "ルネサンス"
  },
  "filename_pattern": "(.+?)(?:さん)\\s*無料体験ヒアリングシート\\.xlsx$"
}
